# Inference model groups.
#
# This file is intentionally a tiny custom syntax, not YAML.
#
# Group syntax:
#   group-name:
#   selector
#   selector
#
# A group contains selectors. Selectors use the same provider/model reference
# syntax as cascaded inference routing selectors:
#   provider>model
#   provider>model@variant
#   provider>model>variant
#   *>model
#   *model
#   *
#
# Groups are referenced from cascaded inference routing rules with `$group-name`.
# Group references can be used in boolean expressions with:
#   &   AND
#   |   OR
#   !   NOT
#   ( ) nesting
#
# Example:
#   *>($weak-model & !($cheap-model | $fast-model)) = crofai>$strong-model
#
# Comments start with # anywhere on a line. Empty and whitespace-only lines are ignored.

weak-model:
  *>greg-1
  *>qwen3.5-9b
  commandcode>step-3.5-flash

cheap-model:
  commandcode>deepseek-v4-pro
  commandcode>deepseek-v4-flash
  commandcode>mimo-v2.5-pro
  commandcode>mimo-v2.5
  commandcode>hy3
  crofai>greg-1@greg-1-mini
  crofai>deepseek-v4-flash
  crofai>qwen3.5-9b

fast-model:
  commandcode>kimi-k2.7-code@highspeed
  commandcode>glm-5.2@fast
  commandcode>deepseek-v4-flash
  commandcode>step-3.7-flash
  commandcode>step-3.5-flash
  crofai>greg-1@greg-1-mini
  crofai>deepseek-v4-pro@deepseek-v4-pro-lightning
  crofai>kimi-k2.5@kimi-k2.5-lightning

slow-model:
  commandcode>kimi-k2.7-code@standard
  commandcode>glm-5.2@standard
  commandcode>qwen3.7-max
  crofai>greg-1@greg-1-super
  crofai>deepseek-v4-pro@deepseek-v4-pro-precision
  crofai>mimo-v2.5-pro@mimo-v2.5-pro-precision
  crofai>glm-5.1@glm-5.1-precision

strong-model:
  commandcode>kimi-k2.7-code
  commandcode>deepseek-v4-pro
  commandcode>glm-5.2
  commandcode>grok-4.5
  crofai>deepseek-v4-pro
  crofai>mimo-v2.5-pro
  crofai>glm-5.1
  deepseek>deepseek-v4-pro

reliable-model:
  commandcode>kimi-k2.7-code
  commandcode>deepseek-v4-pro
  commandcode>glm-5.2
  commandcode>grok-4.5
  crofai>deepseek-v4-pro
  crofai>kimi-k2.6
  deepseek>deepseek-v4-pro
