{
	"name": "pirun",
	"private": true,
	"version": "0.2.0",
	"description": "Stable front door for delegating work to coding-agent harness CLIs.",
	"type": "module",
	"scripts": {
		"test": "node scripts/max-lines.mjs && node --test test/*.test.ts",
		"check": "node scripts/check-syntax.mjs && node scripts/max-lines.mjs",
		"prepare": "node scripts/setup-hooks.mjs",
		"setup-hooks": "node scripts/setup-hooks.mjs",
		"pirun": "node bin/pirun.ts",
		"setup": "node bin/install.ts"
	},
	"dependencies": {
		"gpt-tokenizer": "4.0.0"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"bin": {
		"pirun": "bin/pirun.ts"
	}
}
